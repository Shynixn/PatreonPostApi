{
  "manifest_version": 3,
  "name": "Papoa Chrome Extension",
  "version": "1.0",
  "key": "",
  "description": "Papoa allows you to programmatically prepare and publish posts on patreon.com. This project is not affiliated with Patreon.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://www.patreon.com/*"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png",
      "144": "icon.png"
    }
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png",
    "144": "icon.png"
  },
  "content_scripts": []
}